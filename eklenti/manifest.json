{
  "manifest_version": 3,
  "name": "Artı Not",
  "version": "1.0",
  "description": "Görünen metin bloklarının konumunu yerel Artı Not uygulamasına bildirir.",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
